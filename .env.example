# NapCat — required / 必填
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=

# LLM — required, OpenAI-compatible / 必填，OpenAI 兼容接口
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.7-plus
# Other models also need their provider's limits / 其他模型需填写服务商支持的容量
# LLM_CONTEXT_WINDOW=
# LLM_MAX_OUTPUT_TOKENS=

# Edge TTS — no API key needed / 无需密钥
TTS_VOICE=zh-CN-XiaoxiaoNeural

# SiliconFlow — optional OCR and transcription / 可选，OCR 与语音转写
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# Tavily — optional web search / 可选，网页搜索
TAVILY_SEARCH_API_KEY=

# Jev — optional group-reply detection / 可选，群聊接话判断
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
