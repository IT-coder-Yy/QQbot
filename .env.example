# NapCat
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=你的NapCat WebSocket Token

# LLM
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen3.7-plus
# Model Limits
# qwen3.7-plus 自动使用 1000000 / 131072，以下两项仅供其他模型使用
LLM_CONTEXT_WINDOW=
LLM_MAX_OUTPUT_TOKENS=
# 估算余量，不是普通聊天输出限制
LLM_CONTEXT_SAFETY_MARGIN=8192

# 硅基流动 OCR / ASR（需免费账户 API Key，不自动切换付费模型）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# 持久化：两个独立的全局 50 MB 业务配额，目录必须持久挂载
BOT_DATA_DIR=data
CONVERSATION_STORAGE_BYTES=50000000
ATTACHMENT_STORAGE_BYTES=50000000
STORAGE_CLEANUP_INTERVAL=60

# 本地文档转换及附件下载；只在 NapCat 返回本地路径时设置共享根目录
LIBREOFFICE_BIN=soffice
NAPCAT_FILE_ROOT=
# 额外允许下载的精确主机名，逗号分隔；QQ/NapCat 主机默认允许
MEDIA_DOWNLOAD_HOSTS=
CHAT_TASK_TIMEOUT=600
MEDIA_TASK_TIMEOUT=900
LLM_REQUEST_TIMEOUT=300
MEDIA_API_TIMEOUT=120
# Edge 在线语音，无需 API Key；发送及转码仍使用 MEDIA_API_TIMEOUT
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_TIMEOUT=30
# 连发短消息的间隔（秒）；0 表示不额外等待
CHAT_REPLY_INTERVAL=0.8
# 同一人连续文字的停顿等待（秒）；等待期间不占模型并发额度，0 关闭合并
CHAT_INPUT_DEBOUNCE_SECONDS=1.2
# 既有私聊续聊：成功互动后静默多久尝试一次（秒）；0 关闭；不控制群聊
CHAT_PROACTIVE_IDLE_SECONDS=900
# 全部群的主动聊天：发不发、聊什么和下次时间由主模型决定
CHAT_PROACTIVE_TIMEZONE=Asia/Shanghai
CHAT_PROACTIVE_START_HOUR=10
CHAT_PROACTIVE_END_HOUR=23
# 群清单刷新及故障后再次评估的间隔（秒），不是正常发言间隔
CHAT_PROACTIVE_GROUP_REFRESH_SECONDS=300
CHAT_PROACTIVE_RETRY_SECONDS=900

# Jev
TYPESAFE_API_KEY=
# SDK 默认就是 jev-latest，
TYPESAFE_DEFAULT_MODEL=jev-latest
# 机器人称呼，逗号分隔；用于群聊接话与主模型身份说明
BOT_NAMES=糖糖,村头洋哥

# Web Search
TAVILY_SEARCH_API_KEY=
