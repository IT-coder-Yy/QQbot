# NapCat
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=你的NapCat WebSocket Token

# LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Model Limits
# 模型最大 Context Window
LLM_CONTEXT_WINDOW=
# 单次最大输出 Token
LLM_MAX_OUTPUT_TOKENS=
# 为 tokenizer 误差、消息模板、工具 Schema 等预留空间
LLM_CONTEXT_SAFETY_MARGIN=

# Jev
TYPESAFE_API_KEY=
# SDK 默认就是 jev-latest，
TYPESAFE_DEFAULT_MODEL=jev-latest

# Web Search
TAVILY_SEARCH_API_KEY=

# 持久化存储
BOT_DATA_DIR=data
CONVERSATION_STORAGE_BYTES=50000000
ATTACHMENT_STORAGE_BYTES=50000000
STORAGE_CLEANUP_INTERVAL=60

BOT_NAMES=糖糖,村头洋哥

CHAT_INPUT_DEBOUNCE_SECONDS=1.2

CHAT_REPLY_INTERVAL=0.8

CHAT_PROACTIVE_IDLE_SECONDS=900
CHAT_PROACTIVE_TIMEZONE=Asia/Shanghai
CHAT_PROACTIVE_START_HOUR=10
CHAT_PROACTIVE_END_HOUR=23
CHAT_PROACTIVE_GROUP_REFRESH_SECONDS=300
CHAT_PROACTIVE_RETRY_SECONDS=900
